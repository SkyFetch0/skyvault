{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SkyVault",
  "version": "0.1.0",
  "identifier": "net.skyfetch.skyvault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SkyVault",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0e1015"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Şifreli SSH kasası ve tünel yöneticisi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
